# Copie este archivo como .env y ajuste los valores. NO suba .env a GitHub.
NODE_ENV=development
PORT=4000

# MongoDB local (o la cadena de MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sigca

# Genere un secreto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# URL del frontend (CORS). Varias separadas por coma.
CLIENT_URL=http://localhost:5173

ZONA_HORARIA=America/Guatemala
